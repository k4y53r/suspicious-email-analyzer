# Copia a ~/.config/analista-correo/buzon.env (o a la ruta de ANALISTA_CORREO_ENV) y chmod 600. Contraseña de aplicación, no la principal.
IMAP_HOST=imap.example.org
IMAP_PORT=993
SMTP_HOST=smtp.example.org
SMTP_PORT=465
MAIL_USER=analista@example.org
MAIL_PASS=cambia-esto
# Direcciones desde las que aceptas reenvíos (separadas por comas); el resto se marca como leído sin responder.
REMITENTES=yo@example.org,otra-cuenta@example.org
# Nombre del MX de tu proveedor: se confía solo en su Authentication-Results (mira las cabeceras de un correo recibido).
MX_BUZON=mx.example.org
# si (recomendado): descarta los reenvíos cuyo DKIM no sea pass y del dominio del From; si MX_BUZON no está bien
# configurado se descartará todo. no: solo avisa, y cualquiera que falsifique el From de REMITENTES provoca un análisis.
EXIGIR_DKIM=si
# Opcional: Auth-Key gratuita de abuse.ch (ThreatFox, URLhaus); sin ella se omiten.
#ABUSECH_AUTH_KEY=
