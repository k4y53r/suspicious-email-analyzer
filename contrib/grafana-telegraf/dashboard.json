      "type": "influxdb",
      "uid": "${DS_INFLUXDB}"
     },
     "query": "tmax = (from(bucket: \"home\")\n  |> range(start: -1y)\n  |> filter(fn: (r) => r._measurement == \"correo_total\" and r.host == \"${host}\" and r._field == \"correos\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_time\"))[0]\nfrom(bucket: \"home\")\n  |> range(start: -1y)\n  |> filter(fn: (r) => r._measurement == \"correo_total\" and r.host == \"${host}\")\n  |> last()\n  |> filter(fn: (r) => r._time == tmax)\n  |> filter(fn: (r) => contains(value: r._field, set: [\"correos\", \"malicioso\", \"sospechoso\", \"spam\", \"legitimo\"]))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"correos\", \"malicioso\", \"sospechoso\", \"spam\", \"legitimo\"])",
